{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "best",
  "permissions": {
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin v2-cliente)",
      "Bash(git push origin v2-cliente *)",
      "Bash(git push origin backup-main)",
      "Bash(git push origin backup-main *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Edit(./lulo_app/dataset/**)",
      "Edit(./data/raw/**)"
    ]
  }
}
