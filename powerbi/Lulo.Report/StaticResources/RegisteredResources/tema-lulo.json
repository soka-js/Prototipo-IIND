{
  "name": "Lulo · prototipo",
  "dataColors": [
    "#8A9E00",
    "#3987e5",
    "#d95926",
    "#9085e9",
    "#199e70",
    "#c98500"
  ],
  "background": "#0B1430",
  "foreground": "#FFFFFF",
  "tableAccent": "#E8FF00",
  "good": "#62E3A0",
  "neutral": "#FFB547",
  "bad": "#EA6E66",
  "maximum": "#8A9E00",
  "center": "#647B9A",
  "minimum": "#131E3D",
  "textClasses": {
    "callout": {
      "fontSize": 30,
      "fontFace": "Segoe UI Semibold",
      "color": "#FFFFFF"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#FFFFFF"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#FFFFFF"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#AFB8CC"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#131E3D"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 12
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#AFB8CC"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#1E2B50"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#AFB8CC"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#1E2B50"
              }
            },
            "gridlineStyle": "solid"
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#AFB8CC"
              }
            }
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0B1430"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#0B1430"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 28
          }
        ],
        "categoryLabels": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#131E3D"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#1E2B50"
              }
            }
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#131E3D"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#18244A"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "background": {
              "solid": {
                "color": "#131E3D"
              }
            }
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#AFB8CC"
              }
            }
          }
        ]
      }
    }
