            "name": "dim_lab_escenario",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Tabla = LeerCsv(\"dim_lab_escenario.csv\"),",
                "    Tipos = Table.TransformColumnTypes(Tabla, {{\"escenario\", type text}, {\"descripcion\", type text}, {\"orden\", Int64.Type}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Escenario del laboratorio",
            "expression": "IF ( HASONEVALUE ( dim_lab_escenario[escenario] ), VALUES ( dim_lab_escenario[escenario] ), \"señal\" )",
            "lineageTag": "ee95ae44-6e2c-5aaa-96fa-fe32e99936a7",
            "displayFolder": "6 · Laboratorio",
            "description": "El de la segmentación; si no hay uno solo, «señal»."
          },
          {
            "name": "Descripción del escenario del laboratorio",
            "expression": [
              "VAR e = [Escenario del laboratorio]",
              "RETURN",
              "    CALCULATE ( LOOKUPVALUE ( dim_lab_escenario[descripcion], dim_lab_escenario[escenario], e ), REMOVEFILTERS ( dim_lab_escenario ) )"
            ],
            "lineageTag": "fbfaa107-f49b-5827-8de5-3301d6467ae1",
            "displayFolder": "6 · Laboratorio"
          }
        ]
      },
