        "partitions": [
          {
            "name": "dim_escenario",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Tabla = LeerCsv(\"dim_escenario.csv\"),",
                "    Tipos = Table.TransformColumnTypes(Tabla, {{\"escenario\", type text}, {\"nombre\", type text}, {\"descripcion\", type text}, {\"orden\", Int64.Type}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Escenario elegido",
            "expression": [
              "IF (",
              "    HASONEVALUE ( dim_escenario[escenario] ),",
              "    VALUES ( dim_escenario[escenario] ),",
              "    CALCULATE ( LOOKUPVALUE ( dim_escenario[escenario], dim_escenario[orden], 1 ), REMOVEFILTERS ( dim_escenario ) )",
              ")"
            ],
            "lineageTag": "ec4055fe-437f-51a2-9974-e5e03156408b",
            "displayFolder": "0 · Escenario",
            "description": "El escenario de la segmentación; si no hay uno solo, el de orden 1."
          },
          {
            "name": "Nombre del escenario",
            "expression": [
              "VAR e = [Escenario elegido]",
              "RETURN",
              "    CALCULATE ( LOOKUPVALUE ( dim_escenario[nombre], dim_escenario[escenario], e ), REMOVEFILTERS ( dim_escenario ) )"
            ],
            "lineageTag": "e5fc7a91-11fa-52bc-8fad-85e5f96e7e4f",
            "displayFolder": "0 · Escenario"
          },
          {
            "name": "Descripción del escenario",
            "expression": [
              "VAR e = [Escenario elegido]",
              "RETURN",
              "    CALCULATE ( LOOKUPVALUE ( dim_escenario[descripcion], dim_escenario[escenario], e ), REMOVEFILTERS ( dim_escenario ) )"
            ],
            "lineageTag": "6c5c7f61-3d50-53a2-b4ab-6e08fe314685",
            "displayFolder": "0 · Escenario"
          }
        ]
      },
