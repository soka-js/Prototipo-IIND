            "name": "piloto_ventas",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Tabla = LeerCsv(\"piloto_ventas.csv\"),",
                "    Tipos = Table.TransformColumnTypes(Tabla, {{\"escenario\", type text}, {\"fecha\", type date}, {\"cliente_id\", type text}, {\"ramo\", type text}, {\"origen\", type text}, {\"canal\", type text}, {\"comision_12m_cop\", Int64.Type}}, \"en-US\")",
                "in",
