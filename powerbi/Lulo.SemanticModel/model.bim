                "    Tipos = Table.TransformColumnTypes(Tabla, {{\"escenario\", type text}, {\"variable\", type text}, {\"etiqueta\", type text}, {\"verdad\", type number}, {\"ronda\", Int64.Type}, {\"estimado\", type number}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Peso aprendido al final (lab)",
            "expression": [
              "VAR e = [Escenario del laboratorio]",
              "VAR r = CALCULATE ( MAX ( lab_pesos[ronda] ), REMOVEFILTERS ( lab_pesos ) )",
              "RETURN",
              "    CALCULATE ( AVERAGE ( lab_pesos[estimado] ), dim_lab_escenario[escenario] = e, lab_pesos[ronda] = r )"
            ],
            "lineageTag": "7ece0c95-0e32-54e6-bfbe-c402792b39da",
            "displayFolder": "6 · Laboratorio",
            "formatString": "0.000",
            "description": "Lo que el motor cree de cada efecto después de la última ronda (escala probit)."
          },
          {
            "name": "Peso verdadero (lab)",
            "expression": [
              "VAR e = [Escenario del laboratorio]",
              "RETURN",
              "    CALCULATE ( AVERAGE ( lab_pesos[verdad] ), dim_lab_escenario[escenario] = e )"
            ],
            "lineageTag": "c6ae67e1-663a-5fa7-aad8-67b3c55349c1",
            "displayFolder": "6 · Laboratorio",
