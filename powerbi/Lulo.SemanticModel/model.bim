        "partitions": [
          {
            "name": "piloto_decisiones",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Tabla = LeerCsv(\"piloto_decisiones.csv\"),",
                "    Tipos = Table.TransformColumnTypes(Tabla, {{\"escenario\", type text}, {\"fecha\", type date}, {\"cliente_id\", type text}, {\"ramo\", type text}, {\"canal\", type text}, {\"resultado\", type text}, {\"grupo\", type text}, {\"politica\", type text}, {\"p_motor\", type number}, {\"version_reglas\", type text}, {\"fuerza\", type text}, {\"momento\", Int64.Type}, {\"tipo\", type text}, {\"explora\", Int64.Type}, {\"alcance\", type number}, {\"valor_esperado_cop\", Int64.Type}, {\"comision_12m_cop\", Int64.Type}, {\"ramo_regla\", type text}, {\"coincide_regla\", Int64.Type}, {\"comision_12m_regla_cop\", Int64.Type}, {\"p_verdad\", type number}, {\"p_verdad_regla\", type number}, {\"tramo_p_motor\", type text}, {\"tramo_orden\", Int64.Type}, {\"momento_texto\", type text}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Decisiones",
            "expression": [
              "VAR e = [Escenario elegido]",
              "RETURN",
              "    CALCULATE ( COUNTROWS ( piloto_decisiones ), dim_escenario[escenario] = e )"
            ],
            "lineageTag": "734daa04-2cc8-5398-9282-2986723a7b2f",
            "displayFolder": "2 · Ofertas",
            "formatString": "#,0"
          },
          {
            "name": "Ofertas mostradas",
            "expression": "CALCULATE ( [Decisiones], piloto_decisiones[canal] <> \"ninguno\" )",
            "lineageTag": "fdcc1e35-903a-553c-ab61-33ba26776c2b",
            "displayFolder": "2 · Ofertas",
            "formatString": "#,0",
            "description": "Push o banner al tratamiento."
          },
          {
            "name": "Ofertas vistas",
            "expression": "CALCULATE ( [Decisiones], piloto_decisiones[resultado] IN { \"aceptada\", \"rechazada\" } )",
            "lineageTag": "061d249c-20db-53e2-8c56-71a26a9b172d",
            "displayFolder": "2 · Ofertas",
            "formatString": "#,0",
            "description": "El cliente vio la oferta (aceptó o rechazó)."
          },
          {
            "name": "Ofertas aceptadas",
            "expression": "CALCULATE ( [Decisiones], piloto_decisiones[resultado] = \"aceptada\" )",
            "lineageTag": "7992c799-fba6-585f-a821-90252ac0dc98",
            "displayFolder": "2 · Ofertas",
            "formatString": "#,0"
          },
          {
            "name": "Ofertas ignoradas",
            "expression": "CALCULATE ( [Decisiones], piloto_decisiones[resultado] = \"ignorada\" )",
            "lineageTag": "c89f0f2b-48c3-5098-8473-fa084c1e1c40",
            "displayFolder": "2 · Ofertas",
            "formatString": "#,0",
            "description": "Se mostró y no hubo respuesta."
          },
          {
            "name": "Decisiones en control",
            "expression": "CALCULATE ( [Decisiones], piloto_decisiones[resultado] = \"control\" )",
            "lineageTag": "1a733bf1-57af-52bd-b507-f5087f42d28d",
            "displayFolder": "2 · Ofertas",
            "formatString": "#,0",
            "description": "El motor decidió y no mostró: así se mide lo que pasa sin ofertas."
          },
          {
            "name": "Conversión por oferta vista",
            "expression": "DIVIDE ( [Ofertas aceptadas], [Ofertas vistas] )",
            "lineageTag": "807c4655-6a1a-55d0-9bbf-c5411a2c525a",
            "displayFolder": "2 · Ofertas",
            "formatString": "0.0 %",
            "description": "Aceptadas sobre vistas: comparable con ventas / impactados de las campañas previas."
          },
          {
            "name": "Alcance",
            "expression": "DIVIDE ( [Ofertas vistas], [Ofertas mostradas] )",
            "lineageTag": "95707327-8d83-585f-9f7b-36c0d83dae50",
            "displayFolder": "2 · Ofertas",
            "formatString": "0.0 %",
            "description": "Vistas sobre mostradas."
          },
          {
            "name": "P(acepta) del motor",
            "expression": [
              "VAR e = [Escenario elegido]",
              "RETURN",
              "    CALCULATE ( AVERAGE ( piloto_decisiones[p_motor] ), dim_escenario[escenario] = e, piloto_decisiones[resultado] IN { \"aceptada\", \"rechazada\" } )"
            ],
            "lineageTag": "7430af83-a0a4-5d0c-9307-3b1eb0a9fb85",
            "displayFolder": "2 · Ofertas",
            "formatString": "0.0 %",
            "description": "Lo que el motor esperaba de las ofertas vistas."
          },
          {
            "name": "Observado frente al motor",
            "expression": "DIVIDE ( [Conversión por oferta vista], [P(acepta) del motor] )",
            "lineageTag": "c4fa0ad7-1514-5405-ac48-cccb300cd68a",
            "displayFolder": "2 · Ofertas",
            "formatString": "0.00",
            "description": "1 = el motor está calibrado; más de 1 = subestima; menos de 1 = sobrestima."
          },
          {
            "name": "Conversión de la campaña previa",
            "expression": [
              "DIVIDE (",
              "    SUMX ( VALUES ( dim_ramo[ramo] ), [Ofertas vistas] * CALCULATE ( MAX ( dim_ramo[conversion_previa] ) ) ),",
              "    [Ofertas vistas]",
              ")"
            ],
            "lineageTag": "3fc3ac18-46fd-585d-86a6-b90dce409b80",
            "displayFolder": "2 · Ofertas",
            "formatString": "0.0 %",
            "description": "Ventas / impactados de la campaña previa de cada ramo, ponderada por las ofertas vistas."
          },
          {
            "name": "Frente a la campaña previa",
            "expression": "DIVIDE ( [Conversión por oferta vista], [Conversión de la campaña previa] ) - 1",
            "lineageTag": "36ea935d-ae47-5196-81c4-b233d2c05c73",
            "displayFolder": "2 · Ofertas",
            "formatString": "+0 %;-0 %;0 %"
          },
          {
            "name": "Coinciden con la regla",
            "expression": "DIVIDE ( CALCULATE ( [Decisiones], piloto_decisiones[coincide_regla] = 1 ), [Decisiones] )",
            "lineageTag": "6e21386e-c00c-5cab-a901-72b482c2afa7",
            "displayFolder": "2 · Ofertas",
            "formatString": "0.0 %",
            "description": "Decisiones en las que el motor eligió el mismo ramo que la regla v1.3."
          },
          {
            "name": "Comisión esperada del motor (simulación)",
            "expression": [
              "VAR e = [Escenario elegido]",
              "RETURN",
              "    CALCULATE ( SUMX ( piloto_decisiones, piloto_decisiones[p_verdad] * piloto_decisiones[comision_12m_cop] ), dim_escenario[escenario] = e )"
            ],
            "lineageTag": "d7243b08-83cd-54ab-8b99-783bbc55271e",
            "displayFolder": "2 · Ofertas",
            "formatString": "\"$\"#,0",
            "description": "Solo existe en la simulación: con la verdad simulada."
          },
          {
            "name": "Comisión esperada de la regla (simulación)",
            "expression": [
              "VAR e = [Escenario elegido]",
              "RETURN",
              "    CALCULATE ( SUMX ( piloto_decisiones, piloto_decisiones[p_verdad_regla] * piloto_decisiones[comision_12m_regla_cop] ), dim_escenario[escenario] = e )"
            ],
            "lineageTag": "59fefcdf-b2e2-51af-9c57-f6f181ed330c",
            "displayFolder": "2 · Ofertas",
            "formatString": "\"$\"#,0",
            "description": "Lo mismo si se hubiera ofrecido lo que elegía la regla."
          },
          {
            "name": "Motor frente a la regla (simulación)",
            "expression": "DIVIDE ( [Comisión esperada del motor (simulación)], [Comisión esperada de la regla (simulación)] ) - 1",
            "lineageTag": "321cd7eb-e6cb-5f42-82a2-8956c9c5972c",
            "displayFolder": "2 · Ofertas",
            "formatString": "+0.0 %;-0.0 %;0.0 %"
          }
        ]
      },
      {
