            "formatString": "#,0"
          },
          {
            "name": "Compraron control",
            "expression": "CALCULATE ( [Clientes que compraron], dim_cliente[grupo] = \"control\" )",
            "lineageTag": "262632e8-d852-5d24-a784-3c0408d74ef3",
            "displayFolder": "1 · Resultado del piloto",
            "formatString": "#,0"
          },
          {
            "name": "Conversión tratamiento",
            "expression": "DIVIDE ( [Compraron tratamiento], [Clientes tratamiento] )",
            "lineageTag": "4ffd1fda-56cf-52ea-a402-e17ca62710e3",
            "displayFolder": "1 · Resultado del piloto",
            "formatString": "0.0 %"
          },
          {
            "name": "Conversión control",
            "expression": "DIVIDE ( [Compraron control], [Clientes control] )",
            "lineageTag": "b050dc88-5923-5ada-be48-138901d8fc7e",
            "displayFolder": "1 · Resultado del piloto",
            "formatString": "0.0 %",
            "description": "Compran por su cuenta, sin ofertas."
          },
          {
            "name": "Diferencia frente al control (pp)",
            "expression": "( [Conversión tratamiento] - [Conversión control] ) * 100",
            "lineageTag": "f4a70395-43df-568d-918d-e10ac6eef5cb",
            "displayFolder": "1 · Resultado del piloto",
            "formatString": "+0.0 \"pp\";-0.0 \"pp\";0.0 \"pp\"",
            "description": "Puntos porcentuales de clientes que compran de más con las ofertas: la cifra que dice si el motor vende."
          },
          {
            "name": "Error estándar de la diferencia",
            "expression": [
              "VAR pt = [Conversión tratamiento]",
              "VAR pc = [Conversión control]",
              "RETURN",
              "    SQRT ( DIVIDE ( pt * ( 1 - pt ), [Clientes tratamiento] ) + DIVIDE ( pc * ( 1 - pc ), [Clientes control] ) )"
            ],
            "lineageTag": "b9d030bf-f546-5dae-93e7-409eb074cd15",
            "displayFolder": "1 · Resultado del piloto",
            "formatString": "0.0000"
          },
          {
            "name": "Diferencia IC 95 % bajo (pp)",
            "expression": "[Diferencia frente al control (pp)] - 1.96 * [Error estándar de la diferencia] * 100",
            "lineageTag": "56344b3c-5e37-50db-8a97-6442db987a24",
            "displayFolder": "1 · Resultado del piloto",
            "formatString": "+0.0 \"pp\";-0.0 \"pp\";0.0 \"pp\""
          },
          {
            "name": "Diferencia IC 95 % alto (pp)",
            "expression": "[Diferencia frente al control (pp)] + 1.96 * [Error estándar de la diferencia] * 100",
            "lineageTag": "04ad8462-badb-5da3-baa8-ff9fd6487c1a",
            "displayFolder": "1 · Resultado del piloto",
            "formatString": "+0.0 \"pp\";-0.0 \"pp\";0.0 \"pp\""
          },
          {
            "name": "Intervalo de la diferencia",
            "expression": "FORMAT ( [Diferencia IC 95 % bajo (pp)], \"+0.0;-0.0\" ) & \" a \" & FORMAT ( [Diferencia IC 95 % alto (pp)], \"+0.0;-0.0\" ) & \" pp\"",
            "lineageTag": "38e6d647-82c0-55a0-a96a-54c6592ef42d",
            "displayFolder": "1 · Resultado del piloto",
            "description": "Intervalo de 95 % de la diferencia frente al control."
          },
          {
            "name": "Valor p",
            "expression": [
              "VAR nt = [Clientes tratamiento]",
              "VAR nc = [Clientes control]",
              "VAR p = DIVIDE ( [Compraron tratamiento] + [Compraron control], nt + nc )",
              "VAR se = SQRT ( p * ( 1 - p ) * ( DIVIDE ( 1, nt ) + DIVIDE ( 1, nc ) ) )",
              "VAR z = DIVIDE ( [Conversión tratamiento] - [Conversión control], se )",
              "RETURN",
              "    IF ( nt > 0 && nc > 0, 2 * ( 1 - NORM.S.DIST ( ABS ( z ), TRUE ) ) )"
            ],
            "lineageTag": "0f189148-0122-5d8c-b05f-ef7f006be2e8",
            "displayFolder": "1 · Resultado del piloto",
            "formatString": "0.0000",
            "description": "Prueba z de dos proporciones (dos colas)."
          },
          {
            "name": "Ventas incrementales",
            "expression": "( [Conversión tratamiento] - [Conversión control] ) * [Clientes tratamiento]",
            "lineageTag": "a3582800-2079-55be-9a51-18373a5c16e3",
            "displayFolder": "1 · Resultado del piloto",
            "formatString": "#,0",
            "description": "Clientes que compraron gracias a las ofertas: la diferencia frente al control por el tamaño del tratamiento."
          },
          {
            "name": "Comisión por cliente tratamiento",
            "expression": [
              "VAR e = [Escenario elegido]",
              "RETURN",
              "    DIVIDE ( CALCULATE ( SUM ( piloto_clientes[comision_12m_cop] ), dim_escenario[escenario] = e, dim_cliente[grupo] = \"tratamiento\" ), [Clientes tratamiento] )"
            ],
            "lineageTag": "c3597046-42dc-5c0c-9232-4a204d91469e",
            "displayFolder": "1 · Resultado del piloto",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Comisión por cliente control",
            "expression": [
              "VAR e = [Escenario elegido]",
              "RETURN",
              "    DIVIDE ( CALCULATE ( SUM ( piloto_clientes[comision_12m_cop] ), dim_escenario[escenario] = e, dim_cliente[grupo] = \"control\" ), [Clientes control] )"
            ],
            "lineageTag": "a553121f-0f81-539b-8d3d-64345c820583",
            "displayFolder": "1 · Resultado del piloto",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Comisión incremental 12 m",
            "expression": "( [Comisión por cliente tratamiento] - [Comisión por cliente control] ) * [Clientes tratamiento]",
            "lineageTag": "df3c815c-0113-5b73-b5e2-647b58c6b028",
            "displayFolder": "1 · Resultado del piloto",
            "formatString": "\"$\"#,0",
            "description": "Comisión esperada a 12 meses (catálogo) que se gana de más con las ofertas."
          },
          {
            "name": "Efecto mínimo detectable (pp)",
            "expression": [
              "VAR p = DIVIDE ( [Compraron tratamiento] + [Compraron control], [Clientes tratamiento] + [Clientes control] )",
              "RETURN",
              "    ( 1.96 + 0.8416 ) * SQRT ( p * ( 1 - p ) * ( DIVIDE ( 1, [Clientes tratamiento] ) + DIVIDE ( 1, [Clientes control] ) ) ) * 100"
            ],
            "lineageTag": "26183e0c-834c-5634-b877-1ca59ff9f246",
            "displayFolder": "1 · Resultado del piloto",
            "formatString": "0.0 \"pp\"",
            "description": "Con estos tamaños, la menor diferencia que se detecta con 95 % de confianza y 80 % de potencia."
          },
          {
            "name": "Veredicto",
            "expression": [
              "VAR nc = [Clientes control]",
              "VAR nt = [Clientes tratamiento]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        nc = 0 || nt = 0, \"Sin grupo de control no se puede saber si las ofertas venden\",",
              "        [Diferencia IC 95 % bajo (pp)] > 0, \"Sí: con las ofertas compran más clientes que sin ellas\",",
              "        [Diferencia IC 95 % alto (pp)] < 0, \"No: con las ofertas compran menos clientes que sin ellas\",",
              "        \"Todavía no se sabe: la diferencia cabe en el azar\"",
              "    )"
            ],
            "lineageTag": "815ead88-06cb-508f-bf1c-e54bbacf85ec",
            "displayFolder": "1 · Resultado del piloto",
            "description": "Lectura del intervalo de 95 % de la diferencia frente al control."
          },
          {
            "name": "Lectura de la muestra",
            "expression": [
              "VAR xt = [Compraron tratamiento]",
              "VAR xc = [Compraron control]",
              "VAR m = MIN ( MIN ( xt, [Clientes tratamiento] - xt ), MIN ( xc, [Clientes control] - xc ) )",
              "RETURN",
              "    IF ( m < 5, \"Muestra chica: con menos de 5 casos en un grupo la lectura es frágil. El piloto real necesita la base completa de Lulo (M6).\", \"Muestra suficiente para la prueba de dos proporciones.\" )"
            ],
            "lineageTag": "b4f07102-caed-50e3-962c-dae1436a2e78",
            "displayFolder": "1 · Resultado del piloto"
          }
        ]
      },
