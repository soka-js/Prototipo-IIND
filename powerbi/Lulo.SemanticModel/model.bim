      {
        "name": "lab_resumen",
        "description": "Laboratorio: resultado final de cada escenario.",
        "lineageTag": "f71d438a-7810-565b-a22b-24f6fde2c473",
        "columns": [
          {
            "name": "escenario",
            "dataType": "string",
            "sourceColumn": "escenario",
            "lineageTag": "9de8998a-f5c9-5594-a9cf-b2c7991b1082",
            "summarizeBy": "none",
            "annotations": [
