            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Tabla = LeerCsv(\"motor_backtest.csv\"),",
                "    Tipos = Table.TransformColumnTypes(Tabla, {{\"metrica\", type text}, {\"valor\", type text}, {\"nota\", type text}}, \"en-US\")",
