              "VAR e = [Escenario elegido]",
              "RETURN",
              "    CALCULATE ( COUNTROWS ( piloto_clientes ), dim_escenario[escenario] = e )"
            ],
            "lineageTag": "b5229b6f-84f5-5df0-bd83-afc956501b4d",
            "displayFolder": "1 · Resultado del piloto",
            "formatString": "#,0",
            "description": "Clientes con al menos una decisión del motor (oferta o control) en el piloto."
          },
          {
            "name": "Clientes que compraron",
            "expression": [
              "VAR e = [Escenario elegido]",
              "RETURN",
              "    CALCULATE ( COUNTROWS ( piloto_clientes ), dim_escenario[escenario] = e, piloto_clientes[compro] = 1 )"
            ],
            "lineageTag": "20cb3617-1182-5084-b3e2-7f1e2f57e66b",
            "displayFolder": "1 · Resultado del piloto",
