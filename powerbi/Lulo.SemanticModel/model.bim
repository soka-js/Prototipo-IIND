        "partitions": [
          {
            "name": "motor_plan",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Tabla = LeerCsv(\"motor_plan.csv\"),",
                "    Tipos = Table.TransformColumnTypes(Tabla, {{\"cliente_id\", type text}, {\"resultado\", type text}, {\"resultado_texto\", type text}, {\"ramo\", type text}, {\"tipo\", type text}, {\"fuerza\", type text}, {\"canal\", type text}, {\"motivo_canal\", type text}, {\"grupo\", type text}, {\"politica\", type text}, {\"explora\", Int64.Type}, {\"p_motor\", type number}, {\"p_ic90_bajo\", type number}, {\"p_ic90_alto\", type number}, {\"alcance\", type number}, {\"valor_esperado_cop\", Int64.Type}, {\"ventas_esperadas\", type number}, {\"comision_esperada_cop\", Int64.Type}, {\"ev_regla_cop\", Int64.Type}, {\"ramo_regla\", type text}, {\"coincide_regla\", Int64.Type}, {\"n_ofrecibles\", Int64.Type}, {\"momento\", Int64.Type}, {\"segmento_motor\", type text}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Clientes de la base",
            "expression": "COUNTROWS ( dim_cliente )",
            "lineageTag": "2b896251-7e9d-58f9-b9b6-9a8e1a5862eb",
            "displayFolder": "4 · Plan del motor",
            "formatString": "#,0"
          },
          {
            "name": "Autorizan ofertas",
            "expression": "CALCULATE ( COUNTROWS ( dim_cliente ), dim_cliente[autoriza_ofertas] = \"Sí\" )",
            "lineageTag": "0318e33b-6d06-571b-9065-f4c95f67f1a0",
            "displayFolder": "4 · Plan del motor",
            "formatString": "#,0",
            "description": "Ley 1581: sin autorización el motor no lee sus movimientos."
          },
          {
            "name": "Ofertas del plan",
            "expression": "CALCULATE ( COUNTROWS ( motor_plan ), motor_plan[resultado] IN { \"shown\", \"banner\" } )",
            "lineageTag": "24f69879-8a15-5661-8b66-e72a461467c7",
            "displayFolder": "4 · Plan del motor",
            "formatString": "#,0"
          },
          {
            "name": "Push del plan",
            "expression": "CALCULATE ( COUNTROWS ( motor_plan ), motor_plan[resultado] = \"shown\" )",
            "lineageTag": "f4f13878-10bd-5819-9148-fb6501ce0197",
            "displayFolder": "4 · Plan del motor",
            "formatString": "#,0"
          },
          {
            "name": "Banner del plan",
            "expression": "CALCULATE ( COUNTROWS ( motor_plan ), motor_plan[resultado] = \"banner\" )",
            "lineageTag": "d22fe8b7-67be-5629-bd55-a562eb648688",
            "displayFolder": "4 · Plan del motor",
            "formatString": "#,0"
          },
          {
            "name": "Control del plan",
            "expression": "CALCULATE ( COUNTROWS ( motor_plan ), motor_plan[resultado] = \"control\" )",
            "lineageTag": "c44f5b5e-6ef5-5e09-8382-4524f2dabb52",
            "displayFolder": "4 · Plan del motor",
            "formatString": "#,0"
          },
          {
            "name": "Ventas esperadas del plan",
            "expression": "SUM ( motor_plan[ventas_esperadas] )",
            "lineageTag": "4e958912-8896-51c3-abae-17d886c5ce1b",
            "displayFolder": "4 · Plan del motor",
            "formatString": "#,0.0",
            "description": "Σ alcance × P(acepta) de las ofertas de hoy."
          },
          {
            "name": "Comisión esperada del plan",
            "expression": "SUM ( motor_plan[comision_esperada_cop] )",
            "lineageTag": "07f3c80f-c96b-5e80-8c81-361d4cf73230",
            "displayFolder": "4 · Plan del motor",
            "formatString": "\"$\"#,0",
            "description": "Σ alcance × P(acepta) × comisión a 12 meses."
          },
          {
            "name": "P(acepta) media del plan",
            "expression": "CALCULATE ( AVERAGE ( motor_plan[p_motor] ), motor_plan[resultado] IN { \"shown\", \"banner\" } )",
            "lineageTag": "b437bbd8-ed4b-5805-bf99-94754867ef32",
            "displayFolder": "4 · Plan del motor",
            "formatString": "0.0 %"
          },
          {
            "name": "Plan coincide con la regla",
            "expression": "DIVIDE ( CALCULATE ( COUNTROWS ( motor_plan ), motor_plan[coincide_regla] = 1 ), CALCULATE ( COUNTROWS ( motor_plan ), NOT ISBLANK ( motor_plan[ramo] ) ) )",
            "lineageTag": "3f1a11d7-235a-5321-8b85-dded954e07bf",
            "displayFolder": "4 · Plan del motor",
            "formatString": "0.0 %"
          }
        ]
      },
      {
