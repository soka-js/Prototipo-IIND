        "measures": [
          {
            "name": "Motor frente a la regla (lab)",
            "expression": [
              "VAR e = [Escenario del laboratorio]",
              "RETURN",
              "    CALCULATE ( AVERAGE ( lab_resumen[motor_frente_a_regla] ), dim_lab_escenario[escenario] = e )"
            ],
            "lineageTag": "31765482-5913-5578-aab1-f78a0d12e059",
            "displayFolder": "6 · Laboratorio",
            "formatString": "+0.0 %;-0.0 %;0.0 %",
            "description": "Comisión por oferta de las últimas 10 rondas."
          },
          {
            "name": "Camino al techo del motor (lab)",
            "expression": [
              "VAR e = [Escenario del laboratorio]",
              "RETURN",
