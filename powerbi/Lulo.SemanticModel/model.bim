    "expressions": [
      {
        "name": "Origen",
        "kind": "m",
        "lineageTag": "b8699196-cd29-58a0-ac2f-c43bd4dd6c9e",
        "description": "Carpeta de los CSV: la URL de GitHub (por defecto) o una carpeta local terminada en \\",
        "expression": "\"https://raw.githubusercontent.com/soka-js/Prototipo-IIND/main/powerbi/datos/\" meta [IsParameterQuery = true, Type = \"Text\", IsParameterQueryRequired = true]"
      },
      {
        "name": "LeerCsv",
        "kind": "m",
        "lineageTag": "7c7cc554-df1b-5c43-8554-ddeb0cbd9d72",
        "expression": [
          "(archivo as text) as table =>",
          "let",
          "    Fuente = if Text.StartsWith(Origen, \"http\") then Web.Contents(Origen, [RelativePath = archivo]) else File.Contents(Origen & archivo),",
          "    Csv = Csv.Document(Fuente, [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
          "    Encabezados = Table.PromoteHeaders(Csv, [PromoteAllScalars = true]),",
          "    Vacios = Table.ReplaceValue(Encabezados, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Encabezados))",
          "in",
          "    Vacios"
        ]
      }
    ],
    "annotations": [
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      },
      {
        "name": "PBI_QueryOrder",
        "value": "[\"Origen\", \"LeerCsv\", \"dim_fecha\", \"dim_ramo\", \"dim_cliente\", \"dim_escenario\", \"base_campanas\", \"base_seguros_mensual\", \"base_pagos_externos\", \"motor_plan\", \"motor_backtest\", \"motor_invariantes\", \"piloto_decisiones\", \"piloto_ventas\", \"piloto_clientes\", \"dim_lab_escenario\", \"lab_series\", \"lab_calibracion\", \"lab_pesos\", \"lab_resumen\", \"lab_apetito\", \"casos\", \"meta\"]"
      }
    ]
  }
