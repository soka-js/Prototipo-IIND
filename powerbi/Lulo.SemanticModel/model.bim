        ],
        "measures": [
          {
            "name": "Ventas",
            "expression": [
              "VAR e = [Escenario elegido]",
              "RETURN",
              "    CALCULATE ( COUNTROWS ( piloto_ventas ), dim_escenario[escenario] = e )"
            ],
            "lineageTag": "757a5a41-45a2-5ce0-a402-737e507e6997",
            "displayFolder": "3 · Ventas",
            "formatString": "#,0"
          },
          {
            "name": "Ventas por oferta",
            "expression": "CALCULATE ( [Ventas], piloto_ventas[origen] = \"oferta\" )",
            "lineageTag": "3fe3e7e3-7011-56b5-adc6-bc88fb4061f0",
            "displayFolder": "3 · Ventas",
            "formatString": "#,0"
          },
          {
            "name": "Compras por su cuenta",
            "expression": "CALCULATE ( [Ventas], piloto_ventas[origen] = \"por su cuenta\" )",
            "lineageTag": "237dcdc5-05a1-5033-b107-92c1da3e7ca5",
            "displayFolder": "3 · Ventas",
            "formatString": "#,0",
            "description": "Sin oferta, en los dos grupos."
          },
          {
            "name": "Comisión 12 m de las ventas",
            "expression": [
              "VAR e = [Escenario elegido]",
              "RETURN",
              "    CALCULATE ( SUM ( piloto_ventas[comision_12m_cop] ), dim_escenario[escenario] = e )"
            ],
            "lineageTag": "0468f2be-fb3d-54af-91aa-b1817f73b599",
            "displayFolder": "3 · Ventas",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Conversión acumulada",
            "expression": [
              "VAR e = [Escenario elegido]",
              "VAR f = MAX ( dim_fecha[fecha] )",
              "VAR inicio = CALCULATE ( MIN ( piloto_clientes[primera_decision] ), REMOVEFILTERS ( dim_cliente ), dim_escenario[escenario] = e )",
              "VAR c = CALCULATE ( DISTINCTCOUNT ( piloto_ventas[cliente_id] ), REMOVEFILTERS ( dim_fecha ), dim_fecha[fecha] <= f, dim_escenario[escenario] = e )",
              "RETURN",
              "    IF ( f >= inicio, DIVIDE ( c, [Clientes en el piloto] ) )"
            ],
            "lineageTag": "512263e4-d528-5020-8d6d-3d1ef71450ed",
            "displayFolder": "3 · Ventas",
            "formatString": "0.0 %",
            "description": "Clientes que ya compraron a esa fecha sobre los clientes del piloto, por grupo."
          }
        ]
      },
      {
