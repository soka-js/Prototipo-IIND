              "RETURN",
              "    CALCULATE ( SUM ( curva[conversion] ), curva[escenario] = e )"
            ],
            "lineageTag": "6a299f29-2c97-5084-8fd9-67ca1dc2e77d",
            "displayFolder": "4 · Valor",
