        ],
        "measures": [
          {
            "name": "Comisión de las ofertas",
            "expression": [
              "VAR e = [Escenario elegido]",
              "RETURN",
              "    CALCULATE ( SUM ( ramo[comision_oferta] ), ramo[escenario] = e ) / 1000000"
            ],
            "lineageTag": "88a9bdb9-786c-51fe-b21b-ee59ae557ebc",
            "displayFolder": "4 · Valor",
            "formatString": "\"$\"#,0.0\" M\"",
            "description": "Comisión a 12 meses de las pólizas vendidas por las ofertas, en millones."
          }
        ]
