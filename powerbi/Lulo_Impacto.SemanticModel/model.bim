        "partitions": [
          {
            "name": "escenario",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fuente = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i45WKk49vDExR0lHyb+gJDM3s7gk0UohNUchN78kv0ihLFUh9/DCYoXC0lSFnESFotT0nESgUkOlWJ1oJTBPITm/qCg1uQQk7JyfV5xaVJaYkl9kBVeuUJmokFqUqICq1EgpNhYA\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [escenario = _t, nombre = _t, orden = _t]),",
                "    Tipos = Table.TransformColumnTypes(Fuente, {{\"escenario\", type text}, {\"nombre\", type text}, {\"orden\", Int64.Type}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Escenario elegido",
            "expression": [
              "IF (",
              "    HASONEVALUE ( escenario[escenario] ),",
              "    VALUES ( escenario[escenario] ),",
              "    CALCULATE ( MIN ( escenario[escenario] ), REMOVEFILTERS ( escenario ), escenario[orden] = 1 )",
              ")"
            ],
            "lineageTag": "53cc502b-c374-58e0-9214-8366ee574355",
            "displayFolder": "1 · Escenario",
            "description": "El escenario del selector; si no hay uno solo, el primero (optimista)."
          },
          {
            "name": "Nombre del escenario",
            "expression": [
              "VAR e = [Escenario elegido]",
              "RETURN",
              "    LOOKUPVALUE ( escenario[nombre], escenario[escenario], e )"
            ],
            "lineageTag": "ccb590b7-0dff-5768-9342-1a4d201392f4",
            "displayFolder": "1 · Escenario"
          }
        ]
      },
