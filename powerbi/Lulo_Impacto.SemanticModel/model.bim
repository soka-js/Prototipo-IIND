            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fuente = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [escenario = _t, seguro = _t, orden = _t, vistas = _t, aceptadas = _t, ventas_oferta = _t, comision_oferta = _t, comision_por_venta = _t]),",
                "    Tipos = Table.TransformColumnTypes(Fuente, {{\"escenario\", type text}, {\"seguro\", type text}, {\"orden\", Int64.Type}, {\"vistas\", Int64.Type}, {\"aceptadas\", Int64.Type}, {\"ventas_oferta\", Int64.Type}, {\"comision_oferta\", Int64.Type}, {\"comision_por_venta\", Int64.Type}}, \"en-US\")",
                "in",
