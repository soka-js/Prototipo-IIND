        "partitions": [
          {
            "name": "indicadores",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fuente = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"VYxLCoAwDESvIl27SNJfcpbSRZHiRhCqF/MMXsxGXegij2EyvJTMVs+jLGY0zkal70DETurHZNFHp531GKAHK6gbCawUfZE8MY/JtDovZZjW1uq0l7+X/asNRMGxfLUO4LawrqM2CPDEnC8=\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [escenario = _t, clientes_trat = _t, clientes_ctrl = _t, compran_trat = _t, compran_ctrl = _t, comision_trat = _t, comision_ctrl = _t, ofertas_mostradas = _t, ofertas_vistas = _t, ofertas_aceptadas = _t, ventas = _t, ventas_oferta = _t]),",
                "    Tipos = Table.TransformColumnTypes(Fuente, {{\"escenario\", type text}, {\"clientes_trat\", Int64.Type}, {\"clientes_ctrl\", Int64.Type}, {\"compran_trat\", Int64.Type}, {\"compran_ctrl\", Int64.Type}, {\"comision_trat\", Int64.Type}, {\"comision_ctrl\", Int64.Type}, {\"ofertas_mostradas\", Int64.Type}, {\"ofertas_vistas\", Int64.Type}, {\"ofertas_aceptadas\", Int64.Type}, {\"ventas\", Int64.Type}, {\"ventas_oferta\", Int64.Type}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Clientes con ofertas",
            "expression": [
              "VAR e = [Escenario elegido]",
              "RETURN",
              "    CALCULATE ( SUM ( indicadores[clientes_trat] ), indicadores[escenario] = e )"
            ],
            "lineageTag": "952ed1fb-565a-58c2-b34f-185245259955",
            "displayFolder": "2 · Conteos",
            "formatString": "#,0",
            "description": "Clientes que recibieron decisiones del motor con ofertas (el 90 %)."
          },
          {
            "name": "Clientes sin ofertas",
            "expression": [
              "VAR e = [Escenario elegido]",
              "RETURN",
              "    CALCULATE ( SUM ( indicadores[clientes_ctrl] ), indicadores[escenario] = e )"
            ],
            "lineageTag": "8da0e954-1762-537e-944b-a9c202b58a1e",
            "displayFolder": "2 · Conteos",
            "formatString": "#,0",
            "description": "El grupo de comparación: el motor decide pero no muestra (10 % por hash)."
          },
          {
            "name": "Compran con ofertas",
            "expression": [
              "VAR e = [Escenario elegido]",
              "RETURN",
              "    CALCULATE ( SUM ( indicadores[compran_trat] ), indicadores[escenario] = e )"
            ],
            "lineageTag": "f0ac3e69-cd74-591b-a572-8834d91f9176",
            "displayFolder": "2 · Conteos",
            "formatString": "#,0"
          },
          {
            "name": "Compran sin ofertas",
            "expression": [
              "VAR e = [Escenario elegido]",
              "RETURN",
              "    CALCULATE ( SUM ( indicadores[compran_ctrl] ), indicadores[escenario] = e )"
            ],
            "lineageTag": "e312932b-0fac-56b7-919b-2cd5ea3da1a5",
            "displayFolder": "2 · Conteos",
            "formatString": "#,0",
            "description": "Compran por su cuenta, sin ofertas."
          },
          {
            "name": "Comisión con ofertas",
            "expression": [
              "VAR e = [Escenario elegido]",
              "RETURN",
              "    CALCULATE ( SUM ( indicadores[comision_trat] ), indicadores[escenario] = e )"
            ],
            "lineageTag": "895c2026-7c94-5701-b1c3-9d84e1feec75",
            "displayFolder": "2 · Conteos",
            "formatString": "\"$\"#,0",
            "description": "Comisión a 12 meses de lo que compraron los clientes con ofertas."
          },
          {
            "name": "Comisión sin ofertas",
            "expression": [
              "VAR e = [Escenario elegido]",
              "RETURN",
              "    CALCULATE ( SUM ( indicadores[comision_ctrl] ), indicadores[escenario] = e )"
            ],
            "lineageTag": "bfbe7f94-fd42-52ed-a973-db8211df9b8c",
            "displayFolder": "2 · Conteos",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Conversión con ofertas",
            "expression": "DIVIDE ( [Compran con ofertas], [Clientes con ofertas] )",
            "lineageTag": "8fc8d9fd-26d6-5941-9582-32867e204ee4",
            "displayFolder": "3 · Impacto",
            "formatString": "0.0 %"
          },
          {
            "name": "Conversión sin ofertas",
            "expression": "DIVIDE ( [Compran sin ofertas], [Clientes sin ofertas] )",
            "lineageTag": "9cb203b7-1651-5286-9189-57b5db9d75f4",
            "displayFolder": "3 · Impacto",
            "formatString": "0.0 %"
          },
          {
            "name": "más clientes compran con las ofertas",
            "expression": "( [Conversión con ofertas] - [Conversión sin ofertas] ) * 100",
            "lineageTag": "2497149e-5edd-5ae3-b55c-1697c0257e5e",
            "displayFolder": "3 · Impacto",
            "formatString": "+0.0 \"pp\";-0.0 \"pp\";0.0 \"pp\"",
            "description": "Diferencia en puntos porcentuales frente al grupo sin ofertas: la cifra que dice si las ofertas venden."
          },
          {
            "name": "Error estándar de la diferencia",
            "expression": [
              "VAR ct = [Conversión con ofertas]",
              "VAR cc = [Conversión sin ofertas]",
              "RETURN",
              "    SQRT ( DIVIDE ( ct * ( 1 - ct ), [Clientes con ofertas] ) + DIVIDE ( cc * ( 1 - cc ), [Clientes sin ofertas] ) )"
            ],
            "lineageTag": "11a4ed97-f557-5745-9243-bcae71ba803e",
            "displayFolder": "3 · Impacto",
            "formatString": "0.0000"
          },
          {
            "name": "Diferencia IC 95 % bajo",
            "expression": "[más clientes compran con las ofertas] - 1.96 * [Error estándar de la diferencia] * 100",
            "lineageTag": "cd5e8e33-9a3f-531a-afc1-1f44e0eb7887",
            "displayFolder": "3 · Impacto",
            "formatString": "+0.0 \"pp\";-0.0 \"pp\";0.0 \"pp\""
          },
          {
            "name": "Diferencia IC 95 % alto",
            "expression": "[más clientes compran con las ofertas] + 1.96 * [Error estándar de la diferencia] * 100",
            "lineageTag": "2f95a81f-c4ad-55df-9ee2-bdeb70d0c4c8",
            "displayFolder": "3 · Impacto",
            "formatString": "+0.0 \"pp\";-0.0 \"pp\";0.0 \"pp\""
          },
          {
            "name": "intervalo de 95 % de la diferencia",
            "expression": "FORMAT ( [Diferencia IC 95 % bajo], \"+0.0;-0.0\", USERCULTURE () ) & \" a \" & FORMAT ( [Diferencia IC 95 % alto], \"+0.0;-0.0\", USERCULTURE () ) & \" pp\"",
            "lineageTag": "41f722ab-c162-58b6-9004-d436ced026c3",
            "displayFolder": "3 · Impacto",
            "description": "Con 95 % de confianza la diferencia real está en este rango. Si no toca el cero, no es azar. USERCULTURE: el mismo separador decimal que el resto de las cifras del equipo donde se abre."
          },
          {
            "name": "¿Las ofertas venden?",
            "expression": [
              "SWITCH (",
              "    TRUE (),",
              "    [Clientes sin ofertas] = 0, \"Sin grupo sin ofertas no se puede saber\",",
              "    [Diferencia IC 95 % bajo] > 0, \"Sí: con ofertas compran más clientes\",",
              "    [Diferencia IC 95 % alto] < 0, \"No: con ofertas compran menos\",",
              "    \"Todavía no se sabe: cabe en el azar\"",
              ")"
            ],
            "lineageTag": "2b6bb498-c55a-5398-8934-660862e6e5ed",
            "displayFolder": "3 · Impacto",
            "description": "Lectura del intervalo de 95 %."
          },
          {
            "name": "clientes con seguro gracias a las ofertas",
            "expression": "( [Conversión con ofertas] - [Conversión sin ofertas] ) * [Clientes con ofertas]",
            "lineageTag": "76204763-2614-54cf-adae-02f33279bd2a",
            "displayFolder": "3 · Impacto",
            "formatString": "#,0",
            "description": "Ventas incrementales: la diferencia frente al grupo sin ofertas por los clientes con ofertas."
          },
          {
            "name": "comisión por cliente contactado",
            "expression": "DIVIDE ( [Comisión con ofertas], [Clientes con ofertas] ) - DIVIDE ( [Comisión sin ofertas], [Clientes sin ofertas] )",
            "lineageTag": "93b7ec43-219a-5b0d-bb93-07dbfada616c",
            "displayFolder": "3 · Impacto",
            "formatString": "\"$\"#,0",
            "description": "Comisión a 12 meses que se gana de más por cada cliente que recibe ofertas."
          },
          {
            "name": "comisión adicional a 12 meses",
            "expression": "[comisión por cliente contactado] * [Clientes con ofertas] / 1000000",
            "lineageTag": "91fcf890-f645-568a-8c79-505a22dd9e5c",
            "displayFolder": "3 · Impacto",
            "formatString": "\"$\"#,0.0\" M\"",
            "description": "En millones de pesos, sobre los clientes de la base sintética que recibieron ofertas."
          },
          {
            "name": "por cada 1.000 clientes contactados (proyección lineal)",
            "expression": "[comisión por cliente contactado] * 1000 / 1000000",
            "lineageTag": "39d67cbb-a74a-55e1-ab98-785729266602",
            "displayFolder": "3 · Impacto",
            "formatString": "\"$\"#,0.0\" M\"",
            "description": "Ilustrativo, no una meta: la comisión por cliente contactado × 1.000, en millones de pesos."
          },
          {
            "name": "pólizas vendidas por las ofertas",
            "expression": [
              "VAR e = [Escenario elegido]",
              "RETURN",
              "    CALCULATE ( SUM ( indicadores[ventas_oferta] ), indicadores[escenario] = e )"
            ],
            "lineageTag": "b6bf3689-8e4f-53e2-b259-2e50666581d1",
            "displayFolder": "4 · Valor",
            "formatString": "#,0"
          },
          {
            "name": "de las ventas vino de una oferta",
            "expression": [
              "VAR e = [Escenario elegido]",
              "RETURN",
              "    DIVIDE ( [pólizas vendidas por las ofertas], CALCULATE ( SUM ( indicadores[ventas] ), indicadores[escenario] = e ) )"
            ],
            "lineageTag": "e08a0d9d-7dca-5797-8705-66c867d25caf",
            "displayFolder": "4 · Valor",
            "formatString": "0.0 %",
            "description": "Incluye las compras por su cuenta de los dos grupos."
          },
          {
            "name": "aceptan la oferta que ven",
            "expression": [
              "VAR e = [Escenario elegido]",
              "RETURN",
              "    DIVIDE (",
              "        CALCULATE ( SUM ( indicadores[ofertas_aceptadas] ), indicadores[escenario] = e ),",
              "        CALCULATE ( SUM ( indicadores[ofertas_vistas] ), indicadores[escenario] = e )",
              "    )"
            ],
            "lineageTag": "13c9cfd9-9171-5a31-8ae6-0230082ca0d3",
            "displayFolder": "4 · Valor",
            "formatString": "0.0 %",
            "description": "Aceptadas sobre vistas: comparable con ventas / impactados de las campañas previas."
          }
        ]
      },
