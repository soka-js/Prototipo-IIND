              "expression": [
                "let",
                "    Fuente = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [escenario = _t, semana = _t, grupo = _t, grupo_orden = _t, conversion = _t]),",
                "    Tipos = Table.TransformColumnTypes(Fuente, {{\"escenario\", type text}, {\"semana\", type date}, {\"grupo\", type text}, {\"grupo_orden\", Int64.Type}, {\"conversion\", type number}}, \"en-US\")",
