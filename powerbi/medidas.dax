// Medidas del dashboard de impacto (las genera scripts/exportar_powerbi.py; no se editan a mano).
// Ya vienen en Lulo_Impacto.SemanticModel/model.bim. Para crearlas a mano: Modelado → Nueva medida, en la
// tabla indicada, y pegar desde el nombre. Las del piloto filtran el escenario elegido; no hacen falta relaciones.


// ===== 1 · Escenario =========================================================

// El escenario del selector; si no hay uno solo, el primero (optimista).
// Tabla: escenario
[Escenario elegido] =
    IF (
        HASONEVALUE ( escenario[escenario] ),
        VALUES ( escenario[escenario] ),
        CALCULATE ( MIN ( escenario[escenario] ), REMOVEFILTERS ( escenario ), escenario[orden] = 1 )
    )

// Tabla: escenario
[Nombre del escenario] =
    VAR e = [Escenario elegido]
    RETURN
        LOOKUPVALUE ( escenario[nombre], escenario[escenario], e )


// ===== 2 · Conteos ===========================================================

// Clientes que recibieron decisiones del motor con ofertas (el 90 %).
// Tabla: indicadores · Formato: #,0
[Clientes con ofertas] =
    VAR e = [Escenario elegido]
    RETURN
        CALCULATE ( SUM ( indicadores[clientes_trat] ), indicadores[escenario] = e )

// El grupo de comparación: el motor decide pero no muestra (10 % por hash).
// Tabla: indicadores · Formato: #,0
[Clientes sin ofertas] =
    VAR e = [Escenario elegido]
    RETURN
        CALCULATE ( SUM ( indicadores[clientes_ctrl] ), indicadores[escenario] = e )

// Tabla: indicadores · Formato: #,0
[Compran con ofertas] =
    VAR e = [Escenario elegido]
    RETURN
        CALCULATE ( SUM ( indicadores[compran_trat] ), indicadores[escenario] = e )

// Compran por su cuenta, sin ofertas.
// Tabla: indicadores · Formato: #,0
[Compran sin ofertas] =
    VAR e = [Escenario elegido]
    RETURN
        CALCULATE ( SUM ( indicadores[compran_ctrl] ), indicadores[escenario] = e )

// Comisión a 12 meses de lo que compraron los clientes con ofertas.
// Tabla: indicadores · Formato: "$"#,0
[Comisión con ofertas] =
    VAR e = [Escenario elegido]
    RETURN
        CALCULATE ( SUM ( indicadores[comision_trat] ), indicadores[escenario] = e )

// Tabla: indicadores · Formato: "$"#,0
[Comisión sin ofertas] =
    VAR e = [Escenario elegido]
    RETURN
        CALCULATE ( SUM ( indicadores[comision_ctrl] ), indicadores[escenario] = e )


// ===== 3 · Impacto ===========================================================

// Tabla: indicadores · Formato: 0.0 %
[Conversión con ofertas] =
    DIVIDE ( [Compran con ofertas], [Clientes con ofertas] )

// Tabla: indicadores · Formato: 0.0 %
[Conversión sin ofertas] =
    DIVIDE ( [Compran sin ofertas], [Clientes sin ofertas] )

// Diferencia en puntos porcentuales frente al grupo sin ofertas: la cifra que dice si las ofertas venden.
// Tabla: indicadores · Formato: +0.0 "pp";-0.0 "pp";0.0 "pp"
[más clientes compran con las ofertas] =
    ( [Conversión con ofertas] - [Conversión sin ofertas] ) * 100

// Tabla: indicadores · Formato: 0.0000
[Error estándar de la diferencia] =
    VAR ct = [Conversión con ofertas]
    VAR cc = [Conversión sin ofertas]
    RETURN
        SQRT ( DIVIDE ( ct * ( 1 - ct ), [Clientes con ofertas] ) + DIVIDE ( cc * ( 1 - cc ), [Clientes sin ofertas] ) )

// Tabla: indicadores · Formato: +0.0 "pp";-0.0 "pp";0.0 "pp"
[Diferencia IC 95 % bajo] =
    [más clientes compran con las ofertas] - 1.96 * [Error estándar de la diferencia] * 100

// Tabla: indicadores · Formato: +0.0 "pp";-0.0 "pp";0.0 "pp"
[Diferencia IC 95 % alto] =
    [más clientes compran con las ofertas] + 1.96 * [Error estándar de la diferencia] * 100

// Con 95 % de confianza la diferencia real está en este rango. Si no toca el cero, no es azar.
// Tabla: indicadores
[intervalo de 95 % de la diferencia] =
    FORMAT ( [Diferencia IC 95 % bajo], "+0.0;-0.0" ) & " a " & FORMAT ( [Diferencia IC 95 % alto], "+0.0;-0.0" ) & " pp"

// Lectura del intervalo de 95 %.
// Tabla: indicadores
[¿Las ofertas venden?] =
    SWITCH (
        TRUE (),
        [Clientes sin ofertas] = 0, "Sin grupo sin ofertas no se puede saber",
        [Diferencia IC 95 % bajo] > 0, "Sí: con ofertas compran más clientes",
        [Diferencia IC 95 % alto] < 0, "No: con ofertas compran menos",
        "Todavía no se sabe: cabe en el azar"
    )

// Ventas incrementales: la diferencia frente al grupo sin ofertas por los clientes con ofertas.
// Tabla: indicadores · Formato: #,0
[clientes nuevos con seguro gracias a las ofertas] =
    ( [Conversión con ofertas] - [Conversión sin ofertas] ) * [Clientes con ofertas]

// Comisión a 12 meses que se gana de más por cada cliente que recibe ofertas.
// Tabla: indicadores · Formato: "$"#,0
[comisión por cliente contactado] =
    DIVIDE ( [Comisión con ofertas], [Clientes con ofertas] ) - DIVIDE ( [Comisión sin ofertas], [Clientes sin ofertas] )

// En millones de pesos, sobre los clientes de la base sintética que recibieron ofertas.
// Tabla: indicadores · Formato: "$"#,0.0" M"
[comisión adicional a 12 meses] =
    [comisión por cliente contactado] * [Clientes con ofertas] / 1000000

// Ilustrativo, no una meta: la comisión por cliente contactado × 1.000, en millones de pesos.
// Tabla: indicadores · Formato: "$"#,0.0" M"
[por cada 1.000 clientes contactados (proyección lineal)] =
    [comisión por cliente contactado] * 1000 / 1000000


// ===== 4 · Valor =============================================================

// Tabla: indicadores · Formato: #,0
[pólizas vendidas por las ofertas] =
    VAR e = [Escenario elegido]
    RETURN
        CALCULATE ( SUM ( indicadores[ventas_oferta] ), indicadores[escenario] = e )

// Incluye las compras por su cuenta de los dos grupos.
// Tabla: indicadores · Formato: 0.0 %
[de las ventas vino de una oferta] =
    VAR e = [Escenario elegido]
    RETURN
        DIVIDE ( [pólizas vendidas por las ofertas], CALCULATE ( SUM ( indicadores[ventas] ), indicadores[escenario] = e ) )

// Aceptadas sobre vistas: comparable con ventas / impactados de las campañas previas.
// Tabla: indicadores · Formato: 0.0 %
[aceptan la oferta que ven] =
    VAR e = [Escenario elegido]
    RETURN
        DIVIDE (
            CALCULATE ( SUM ( indicadores[ofertas_aceptadas] ), indicadores[escenario] = e ),
            CALCULATE ( SUM ( indicadores[ofertas_vistas] ), indicadores[escenario] = e )
        )

// Clientes que ya compraron un seguro a esa semana, sobre los clientes de su grupo.
// Tabla: curva · Formato: 0.0 %
[Clientes que ya compraron] =
    VAR e = [Escenario elegido]
    RETURN
        CALCULATE ( SUM ( curva[conversion] ), curva[escenario] = e )

// Comisión a 12 meses de las pólizas vendidas por las ofertas, en millones.
// Tabla: ramo · Formato: "$"#,0.0" M"
[Comisión de las ofertas] =
    VAR e = [Escenario elegido]
    RETURN
        CALCULATE ( SUM ( ramo[comision_oferta] ), ramo[escenario] = e ) / 1000000

// Tabla: segmento · Formato: 0.0 %
[Aceptación por segmento] =
    VAR e = [Escenario elegido]
    RETURN
        DIVIDE (
            CALCULATE ( SUM ( segmento[aceptadas] ), segmento[escenario] = e ),
            CALCULATE ( SUM ( segmento[vistas] ), segmento[escenario] = e )
        )

// Tabla: origen · Formato: #,0
[Pólizas] =
    VAR e = [Escenario elegido]
    RETURN
        CALCULATE ( SUM ( origen[ventas] ), origen[escenario] = e )


// ===== 5 · Control ===========================================================

// Debe ser 0: backtest de todas las decisiones del motor sobre la base.
// Tabla: reglas · Formato: #,0
[violaciones de las reglas] =
    SUM ( reglas[violaciones] ) + 0

// Tabla: control · Formato: #,0
[push máximo a un cliente en 30 días] =
    LOOKUPVALUE ( control[valor], control[indicador], "push_max_30d" )

// Ley 1581: sin autorización el motor no lee sus movimientos ni les ofrece nada.
// Tabla: control · Formato: #,0
[clientes sin autorización: nunca contactados] =
    LOOKUPVALUE ( control[valor], control[indicador], "sin_autorizacion" )

// Laboratorio: últimas 10 rondas, con verdad simulada.
// Tabla: laboratorio_resumen · Formato: +0.0 %;-0.0 %;0.0 %
[más comisión por oferta que la regla (laboratorio)] =
    VAR e = [Escenario elegido]
    RETURN
        CALCULATE ( SUM ( laboratorio_resumen[motor_frente_a_regla] ), laboratorio_resumen[escenario] = e )

// Tabla: laboratorio · Formato: "$"#,0
[Comisión por oferta] =
    VAR e = [Escenario elegido]
    RETURN
        CALCULATE ( AVERAGE ( laboratorio[comision_por_oferta] ), laboratorio[escenario] = e )
